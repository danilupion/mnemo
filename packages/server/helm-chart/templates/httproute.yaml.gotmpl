{{- if .Values.route.enabled }}
# Gateway API HTTPRoute (the chart's only exposure mechanism). Encodes the same paths the
# server ingress declares (/api, /websocket); the web chart routes everything
# else. Same-hostname routes are merged by the gateway with most-specific path
# precedence.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ include "mnemo-server.fullname" . }}
  labels:
    {{- include "mnemo-server.labels" . | nindent 4 }}
  {{- with .Values.route.annotations }}
  annotations:
    {{- toYaml . | nindent 4 }}
  {{- end }}
spec:
  parentRefs:
    {{- toYaml (required "route.parentRefs is required when route.enabled" .Values.route.parentRefs) | nindent 4 }}
  hostnames:
    {{- toYaml (required "route.hostnames is required when route.enabled" .Values.route.hostnames) | nindent 4 }}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /api
        - path:
            type: PathPrefix
            value: /websocket
      backendRefs:
        - name: {{ include "mnemo-server.fullname" . }}
          port: {{ .Values.service.port }}
      # Websocket connections are long-lived; disable the route timeout
      timeouts:
        request: 0s
{{- end }}
