environments:
  {{ .Environment.Name }}:
    values:
      - environments/{{ .Environment.Name }}/values.yaml

---
releases:
  - name: mnemo-web
    namespace: mnemo
    chart: ./packages/client/helm-chart
    values:
    {{ if hasKey .Values "web" }}
      - {{ toYaml .Values.web | nindent 8 }}
    {{ end }}
    {{ if hasKey .Values "common" }}
      - {{ toYaml .Values.common | nindent 8 }}
    {{ end }}

  - name: mnemo-server
    namespace: mnemo
    chart: ./packages/server/helm-chart
    values:
    {{ if hasKey .Values "server" }}
      - {{ toYaml .Values.server | nindent 8 }}
    {{ end }}
    {{ if hasKey .Values "common" }}
      - {{ toYaml .Values.common | nindent 8 }}
    {{ end }}